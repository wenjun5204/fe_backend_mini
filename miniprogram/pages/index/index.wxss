.container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.badge {
  display: inline-block;
  font-size: 22rpx;
  color: #07c160;
  background: rgba(7, 193, 96, 0.1);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}

.title {
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 600;
}

.desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #888;
}

.btn {
  margin-top: 48rpx;
  background: #07c160;
}

.error {
  margin-top: 32rpx;
  font-size: 26rpx;
  color: #fa5151;
}

.result {
  margin-top: 32rpx;
  font-size: 28rpx;
}

.ok {
  color: #07c160;
}

.time {
  margin-top: 12rpx;
  color: #999;
  font-size: 24rpx;
}
