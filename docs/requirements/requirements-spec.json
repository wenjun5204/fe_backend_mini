    ],
    "answers": [
      {"question": "MVP 的核心转化行为是什么,如何度量?", "answer": "核心行为是抽福签并转发到家人群;北极星指标为每日激活家庭数 DBF(当日≥2名成员完成抽卡并转发),福卡分享率目标≥60%", "source": "user_document", "category": "goal_value"},
      {"question": "用户身份与家族权限如何设计,一人可加入几个家族?", "answer": "微信登录(openid+昵称+头像),MVP 每人限加入 1 个家族;户主可解散家族,无踢人功能;成员上限 8 人", "source": "user_document", "category": "users_permissions"},
      {"question": "MVP 包含哪些功能,明确排除哪些?", "answer": "MVP 含建家/邀请、每日福签(摇卡/翻卡/转发)、今日宜微任务、添福、催福、家内榜+好友家族榜、青铜/白银门牌;排除支付、老照片修复、自定义福卡、私信、同城榜、提现", "source": "user_document", "category": "scope"},
      {"question": "每日福签从生成到分享激活的主流程是什么?", "answer": "定时任务每日 0 点为每个家族生成当日福签(全家同签,等级概率 70/25/5);用户摇一摇或点按钮读取当日福签;转发家人群得 +10 福值;完成今日宜事项得 +15 福值", "source": "user_document", "category": "main_flow"},
      {"question": "福签等级与门牌等级如何流转?", "answer": "福签等级(平安/如意/鸿福)每日生成后固定,只影响卡面华丽度与宜事项数量,不影响福值倍率;门牌等级 NONE→青铜500→白银2000→黄金5000→玉匾20000,只升不降", "source": "user_document", "category": "state"}
    ],
    "confirmed_facts": [
      {"fact": "产品方向为福卡(祈福引擎)+家族福值榜(攀比引擎)合体,健康微任务降级为福签附赠", "source": "user"},
      {"fact": "冷启动策略为家族群内测(5-8个群,100-150人种子)", "source": "user"},
      {"fact": "老照片付费修复放 V2.0,MVP 纯免费", "source": "user"},
      {"fact": "转发采用软引导奖励制(+10福值),不做强制分享,规避微信诱导分享红线", "source": "user_document"},
      {"fact": "合规词表已固化于 .agents/docs/conventions.md:禁用运势/吉凶/求签/算命/占卜/八字/塔罗/改运/挡灾/化解/开光/大师;黄历式福签只宜不忌;无医疗暗示词汇", "source": "code"},
      {"fact": "领域模型 6 实体已定义于 .agents/docs/domain-model.md:Family/FamilyMember/User/DailyFortuneCard/BlessEvent/FortuneDrawRecord", "source": "code"},
      {"fact": "福值只涨不跌,所有变更走 BlessEvent 事件路径,禁止直接改余额", "source": "code"},
      {"fact": "订阅消息每人每日≤4条;催福对同一人每日≤3次;添福每人每天对每位家人1次", "source": "user_document"},
      {"fact": "主前端为 miniprogram/(原生微信小程序),frontend/ React 仅作契约演示端", "source": "code"},
      {"fact": "后端 Spring Boot + Java 21,接口前缀 /api,端口 8080,数据库 H2 文件模式", "source": "code"},
      {"fact": "适老化规范:正文≥17pt,核心≥22pt,主按钮≥88rpx,一屏一个主按钮,功能≤3次点击,零键盘输入优先,文案用您", "source": "user_document"},
      {"fact": "主题色中国红 #b01f24、描金 #ffd76e、米黄底 #fff8ec,福签大字用楷体", "source": "user_document"},
      {"fact": "接口以 OpenAPI 契约为唯一事实源,由 fe-be-contract-harness 驱动,改接口先改契约", "source": "user"}
    ],
    "assumptions": [
      {"assumption": "MVP 阶段微信好友关系由后端互关家族模拟实现(小程序侧无批量好友 API),V1.1 再接微信社交数据", "accepted": true},
      {"assumption": "订阅消息推送在 MVP 以接口形式预留(sendNotification),实际微信模板推送延后到内测配置模板后启用", "accepted": true},
      {"assumption": "微信步数同步不进 MVP(福签微任务全部为确认制,无自动采集)", "accepted": true}
    ],
