.page-me {
  padding: 20rpx 32rpx 48rpx;
}

/* 资料卡 */
.me-hero {
  margin-top: 20rpx;
  border-radius: var(--radius);
  background: var(--card);
  border: 1px solid var(--line);
  box-shadow: 0 8rpx 40rpx rgba(28, 28, 40, 0.07);
  padding: 36rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
}
.mh-ava {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--grad-violet);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #fff;
  font-weight: 900;
}
.mh-name {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--ink);
}
.mh-sub {
  font-size: 25rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
}

/* 数据格 */
.me-stats {
  display: flex;
  gap: 20rpx;
  margin: 28rpx 0;
}
.ms-cell {
  flex: 1;
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 32rpx;
  padding: 28rpx 16rpx;
  text-align: center;
  box-shadow: 0 8rpx 40rpx rgba(28, 28, 40, 0.07);
}
.ms-num {
  display: block;
  font-size: 44rpx;
  font-weight: 900;
  color: var(--ink);
}
.ms-label {
  display: block;
  font-size: 22rpx;
  color: var(--ink-3);
  font-weight: 600;
  margin-top: 6rpx;
}

/* 行式入口 */
.me-rows {
  border-radius: 32rpx;
  overflow: hidden;
  border: 1px solid var(--line);
  box-shadow: 0 8rpx 40rpx rgba(28, 28, 40, 0.07);
}
.mr {
  background: var(--card);
  min-height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  font-size: 30rpx;
  color: var(--ink);
  border-bottom: 1px solid var(--line);
}
.mr:last-child {
  border-bottom: none;
}
.mr-left {
  display: flex;
  align-items: center;
  gap: 22rpx;
  font-weight: 700;
}
.ic {
  font-size: 38rpx;
}
.mr-right {
  color: var(--ink-3);
  font-size: 26rpx;
}
