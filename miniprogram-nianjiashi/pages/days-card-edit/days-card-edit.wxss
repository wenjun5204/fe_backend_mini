/* 相伴天数卡编辑页,视觉对齐原型 .gen-head/.counter-preview */
.bg-sunset {
  background: var(--grad-sunset);
}

.page-days-card-edit {
  padding-bottom: 220rpx;
}

/* ===== 头部(霞橘渐变) ===== */
.gen-head {
  margin: 8rpx 32rpx 0;
  border-radius: var(--radius);
  padding: 40rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}
.g-kicker {
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  opacity: 0.85;
}
.g-title {
  font-size: 46rpx;
  font-weight: 900;
  margin-top: 10rpx;
}
.g-sub {
  font-size: 26rpx;
  margin-top: 12rpx;
  opacity: 0.88;
  line-height: 1.5;
}

.form-block {
  padding: 12rpx 32rpx 0;
}

/* ===== 日期选择框 ===== */
.date-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 0 32rpx;
  border: 3rpx solid var(--line);
  border-radius: 26rpx;
  background: var(--card);
}
.date-text {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 2rpx;
}
.date-arrow {
  font-size: 26rpx;
  color: var(--ink-3);
}

/* ===== 深色实时预览卡 ===== */
.counter-preview {
  margin: 32rpx 32rpx 0;
  padding: 36rpx;
  border-radius: 36rpx;
  background: var(--grad-night);
  color: #fff;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.cp-kicker {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 700;
}
.cp-days {
  font-size: 112rpx;
  font-weight: 900;
  margin-top: 12rpx;
  background: linear-gradient(135deg, #ffd9a0, #ff9d76);
  -webkit-background-clip: text;
  background-clip: text;
  color: #ff9d76;
  -webkit-text-fill-color: transparent;
  line-height: 1.1;
}
.cp-unit {
  font-size: 36rpx;
  color: #fff;
  -webkit-text-fill-color: #fff;
}
.cp-sub {
  font-size: 26rpx;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.75);
}
.cp-line {
  font-size: 30rpx;
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
}

/* ===== 底部主按钮(吸底,safe-area 兜底) ===== */
.next-row {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  background: rgba(251, 250, 247, 0.92);
}
