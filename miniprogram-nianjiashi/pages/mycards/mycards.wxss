/* 我的卡片页,视觉对齐原型 .mc-grid/.mc-card/.mc-empty(双列卡片墙) */

/* 迷你成品卡三套渐变(霞橘/深夜星河/青金) */
.bg-night {
  background: var(--grad-night);
}
.bg-sunset {
  background: var(--grad-sunset);
}
.bg-mint {
  background: var(--grad-teal);
}

.page-mycards {
  padding-bottom: 60rpx;
}

.mc-loading {
  margin-top: 160rpx;
  text-align: center;
  font-size: 27rpx;
  color: var(--ink-3);
}

/* ===== 双列卡片墙 ===== */
.mc-grid {
  padding: 28rpx 32rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}
.mc-card {
  width: calc(50% - 12rpx);
  box-sizing: border-box;
  border-radius: 36rpx;
  overflow: hidden;
  background: var(--card);
  border: 1px solid var(--line);
  box-shadow: 0 8rpx 40rpx rgba(28, 28, 40, 0.07);
}
.mc-cover {
  height: 240rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #fff;
  position: relative;
}
.mc-kicker {
  font-size: 18rpx;
  letter-spacing: 3rpx;
  opacity: 0.75;
  font-weight: 800;
}
.mc-emoji {
  font-size: 72rpx;
}
.mc-days {
  font-size: 52rpx;
  font-weight: 900;
}
.mc-unit {
  font-size: 26rpx;
  font-weight: 800;
}
.mc-body {
  padding: 22rpx 24rpx 24rpx;
}
.mc-name {
  font-size: 29rpx;
  font-weight: 800;
  color: var(--ink);
}
.mc-when {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
}
.mc-acts {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}
.mc-acts button {
  flex: 1;
  min-height: 72rpx;
  line-height: 72rpx;
  border: none;
  border-radius: 20rpx;
  font-size: 25rpx;
  font-weight: 800;
  padding: 0;
}
.mc-view {
  background: #fdf2f4;
  color: var(--rose);
}
.mc-del {
  background: #f4f2ec;
  color: var(--ink-3);
}

/* ===== 空态 ===== */
.mc-empty {
  margin: 120rpx 60rpx;
  text-align: center;
  color: var(--ink-3);
  font-size: 27rpx;
  line-height: 1.9;
}
.mc-empty .big {
  font-size: 88rpx;
  display: block;
  margin-bottom: 24rpx;
}
.mc-empty .hl {
  color: var(--rose);
  font-weight: 800;
}
.mc-go {
  margin-top: 40rpx;
  width: 100%;
}
