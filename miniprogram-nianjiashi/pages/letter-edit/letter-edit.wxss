/* 感恩信选素材页,视觉对齐原型 .gen-head/.pick-chips/.tone-cards */
.bg-night {
  background: var(--grad-night);
}

.page-letter-edit {
  padding-bottom: 200rpx;
}

.gen-head {
  margin: 8rpx 32rpx 0;
  border-radius: var(--radius);
  padding: 40rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}
.g-kicker {
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  opacity: 0.85;
}
.g-title {
  font-size: 46rpx;
  font-weight: 900;
  margin-top: 10rpx;
}
.g-sub {
  font-size: 26rpx;
  margin-top: 12rpx;
  opacity: 0.88;
  line-height: 1.5;
}

.form-block {
  padding: 12rpx 32rpx 0;
}

/* 语气三卡 */
.tone-cards {
  display: flex;
  gap: 16rpx;
}
.tone-card {
  flex: 1;
  min-height: 128rpx;
  border: 3rpx solid var(--line);
  border-radius: 28rpx;
  background: var(--card);
  padding: 20rpx 16rpx;
  text-align: center;
}
.tone-card.on {
  border-color: var(--rose);
  background: #fff3f5;
  box-shadow: inset 0 0 0 2rpx var(--rose);
}
.tone-emoji {
  font-size: 42rpx;
}
.tone-name {
  font-size: 25rpx;
  font-weight: 800;
  color: var(--ink);
  margin-top: 8rpx;
}
.tone-desc {
  font-size: 20rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
}

/* 底部主按钮(吸底,safe-area 兜底) */
.next-row {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  background: rgba(251, 250, 247, 0.92);
}
