# ===== 数据层 =====
APP_PORT=8080
TZ=Asia/Shanghai
SPRING_PROFILES_ACTIVE=selfdeploy
MYSQL_ADDRESS=mysql:3306
MYSQL_DATABASE=quanjiafu
MYSQL_USERNAME=quanjiafu
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
JAVA_OPTS=-XX:MaxRAMPercentage=75.0

# ===== 鉴权三要素(selfdeploy 形态必填,缺失启动即死) =====
# 微信小程序 AppID/AppSecret(MP 后台「开发管理→开发设置」获取)
WX_APP_ID=wx-your-appid
WX_APP_SECRET=your-appsecret
# token HMAC 签名密钥:openssl rand -hex 32 生成;轮换=全员 token 失效(前端自动重登)
AUTH_TOKEN_SECRET=change-me-openssl-rand-hex-32
